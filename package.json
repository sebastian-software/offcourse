{
  "name": "offcourse",
  "version": "1.5.1",
  "description": "Download online courses for offline access – of course!",
  "type": "module",
  "bin": {
    "offcourse": "./dist/cli/index.js"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sebastian-software/offcourse.git"
  },
  "bugs": {
    "url": "https://github.com/sebastian-software/offcourse/issues"
  },
  "homepage": "https://sebastian-software.github.io/offcourse/",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:run && pnpm build",
    "dev": "tsc --watch",
    "start": "node dist/cli/index.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest",
    "test:run": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:all": "pnpm test:run && pnpm test:integration",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm check",
    "prepare": "husky"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "prettier --write"
    ]
  },
  "keywords": [
    "course",
    "downloader",
    "offline",
    "cli",
    "e-learning",
    "video"
  ],
  "author": "Sebastian Software GmbH",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@sindresorhus/slugify": "^3.0.1",
    "better-sqlite3": "^13.0.3",
    "chalk": "^6.0.0",
    "cli-progress": "^3.12.0",
    "commander": "^15.0.0",
    "conf": "^15.1.0",
    "delay": "^7.0.0",
    "execa": "^10.0.1",
    "hls-parser": "^0.16.1",
    "ky": "^2.1.0",
    "ora": "^9.4.1",
    "p-retry": "^8.0.1",
    "playwright": "^1.63.0",
    "turndown": "^7.2.4",
    "untildify": "^6.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/cli-progress": "^3.11.6",
    "@types/node": "^26.6.2",
    "@types/turndown": "^5.0.6",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.8",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  },
  "packageManager": "pnpm@11.17.0+sha512.cca3cea332ad254bb84145f966d19f4879615210346fc92c79a047f23a0d7b3cca3c3792f0076ba1f1831d277efbcf0a9119b31a9a60eca7fb3d6231f331ef72"
}
